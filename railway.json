{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "mercur-backend": {
      "source": {
        "root": "backend"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile"
      },
      "deploy": {
        "numReplicas": 1,
        "sleep": false,
        "restartPolicy": "ON_FAILURE"
      }
    },
    "mercur-admin": {
      "source": {
        "root": "admin-panel"
      },
      "build": {
        "builder": "NIXPACKS"
      }
    },
    "mercur-vendor": {
      "source": {
        "root": "vendor-panel"
      },
      "build": {
        "builder": "NIXPACKS"
      }
    },
    "mercur-storefront": {
      "source": {
        "root": "storefront"
      },
      "build": {
        "builder": "NIXPACKS"
      }
    }
  }
}
