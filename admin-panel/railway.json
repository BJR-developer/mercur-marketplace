{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "yarn install && yarn build:preview"
  },
  "deploy": {
    "startCommand": "yarn preview --port $PORT --host 0.0.0.0",
    "numReplicas": 1,
    "restartPolicy": "ON_FAILURE"
  }
}
